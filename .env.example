# ==========================================
# 🚀 VLM Invoice OCR - Global Configuration
# ==========================================

# 1. Frontend Configuration
FRONTEND_PORT=8002

# 2. Backend API Configuration
BACKEND_PORT=8005

# 3. vLLM Engine Configuration
VLLM_MODEL=cyankiwi/Qwen3.5-2B-AWQ-BF16-INT8
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.8

# 4. Concurrency Settings (Doubled for higher performance)
# How many PDF files can Celery process simultaneously
CELERY_CONCURRENCY=2

# How many pages within a single PDF can be sent to the LLM concurrently
MAX_CONCURRENT_PAGES=10
