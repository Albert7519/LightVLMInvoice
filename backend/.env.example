# LocalllmOcrMK2 Backend Configuration
# Copy this file to .env and modify values for your environment

# vLLM Model Inference Service
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_USE_MODELSCOPE=true
VLLM_GPU_MEMORY_UTILIZATION=0.9

# Redis Message Queue & Task Broker
REDIS_URL=redis://localhost:6379/0

# FastAPI Server Configuration
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
UVICORN_RELOAD=true

# Application Logging (optional)
LOG_LEVEL=INFO

# 系统并发配置
# 控制单份包含多页的发票，最高向 vLLM 同时发起多少次请求 (建议5-10)
MAX_CONCURRENT_PAGES=5
